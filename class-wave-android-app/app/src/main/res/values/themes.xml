<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ClassWave" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/fun_background</item>
        <item name="android:statusBarColor">@color/fun_background</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/fun_background</item>
        <item name="postSplashScreenTheme">@style/Theme.ClassWave</item>
    </style>
</resources>